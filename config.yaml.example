# bomi configuration example
#
# Copy this file to the global config location and fill in your values:
#   macOS: ~/Library/Application Support/bomi/config.yaml
#   Linux: ~/.local/share/bomi/config.yaml
#
# Environment variables override config file values.
# Each key maps to BOMI_<KEY_UPPERCASE>, e.g.:
#   export BOMI_OPENROUTER_API_KEY=sk-or-v1-...

# Required only for `bomi analyze` and `bomi datasheet --summary`.
# Get a key at https://openrouter.ai/
openrouter_api_key: sk-or-v1-...

# Optional: default model for `bomi analyze` and `bomi datasheet --summary`.
# Can be overridden per command with --model.
# default_model: anthropic/claude-sonnet-4.6

# Optional: default output directory for `bomi datasheet` when -o/--output is not set.
# Relative paths are resolved from the active project root when available, else current directory.
# datasheet_output_dir: docs/datasheets

# Optional: manual cost-per-token overrides for `bomi analyze`.
#
# bomi normally determines analysis cost from OpenRouter's actual billed
# `usage.cost` on the response, falling back to a live lookup of
# OpenRouter's published per-model pricing (cached locally and refreshed
# periodically). These overrides are a last resort for models missing from
# that lookup, or for offline use — rates are per 1,000,000 tokens, in USD.
# cost_overrides:
#   some-provider/some-model:
#     prompt_per_1m: 3.0
#     completion_per_1m: 15.0
